generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Group {
  id            String   @id @default(cuid())
  name          String
  partySize     Int
  status        String   // "assembling" | "queued" | "playing" | "completed" | "cancelled"
  position      Int      @default(0)
  enteredQueueAt DateTime?
  assemblingAt  DateTime?
  teedOffAt     DateTime?
  scheduledTime DateTime?
  isPreRegistered Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       Member[]
}

model Member {
  id        String  @id @default(cuid())
  name      String
  arrived   Boolean @default(false)
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model QueueSettings {
  id        String  @id @default("default")
  clubName  String  @default("Fairview Golf Club")
  isPaused  Boolean @default(false)
  pauseReason String?
}
